{
  "name": "dsh-glass-suite",
  "version": "1.0.0",
  "description": "DSH plugin: one frosted-glass suite for the whole shell — gradient backdrop, rounded glass columns, floating tab pills, borderless session header, plus the composer/panel glass materials and an optional wallpaper.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "images",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "icon": "./images/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konglbai/dsh-glass-suite.git"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1"
  },
  "keywords": [
    "dsh",
    "cordis",
    "glass",
    "frosted-glass",
    "glassmorphism",
    "theme",
    "ui",
    "wallpaper"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1"
  }
}
